---
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import BlogCard from '@/components/react/blog-card'
import ProjectTimelineCard from '@/components/ProjectTimelineCard.astro'
import { buttonVariants } from '@/components/ui/button'
import Logo from '@/components/ui/logo'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts, getAllProjects } from '@/lib/data-utils'
import { SITE } from '@/consts'
import { Icon } from 'astro-icon/components'
import { HeroKineticRole } from '@/components/react/HeroKineticRole'
import { AnimatedResumeIcon } from '@/components/react/AnimatedResumeIcon'

const blog = await getRecentPosts(3)
const projects = (await getAllProjects()).slice(0, 2)
const currentUrl = Astro.url;
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="Aman" />
  <section class="flex flex-col gap-y-12 py-8 w-full max-w-full overflow-hidden">
    <div
      class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:gap-8 sm:text-left animate-fade-in-up w-full min-w-0"
    >
      <div class="relative sm:shrink-0">
        <Logo
          className="h-auto w-36 object-cover sm:w-44 md:w-52 lg:w-56"
        />
      </div>
      <div class="mt-8 sm:mt-0 sm:max-w-xl w-full min-w-0">
        <h1
          class="font-custom text-foreground text-start text-4xl font-extrabold sm:text-5xl truncate"
        >
          {SITE.author}
        </h1>
        <div class="mt-4 w-full">
          <HeroKineticRole client:load />
        </div>
        <p class="text-md text-foreground mt-4 text-start font-sans whitespace-normal break-words" title="description" aria-label="description">
          {SITE.description}
        </p>
        <div class="mt-5 flex items-center gap-3">
          <Link
            href="/resume?reference=resume"
            target="_blank"
            class={buttonVariants({ variant: 'default', size: 'sm' }) + ' rounded-full px-4 gap-2 text-xs font-semibold group'}
          >
            <AnimatedResumeIcon client:load className="size-3.5 text-primary-foreground" />
            Resume
          </Link>
        </div>
      </div>
    </div>

    <section class="relative animate-fade-in-up delay-200 w-full min-w-0" aria-labelledby="now-title">
      <div class="flex items-center gap-2">
        <h2
          id="now-title"
          class="font-custom text-foreground text-xl sm:text-2xl font-bold break-words"
          title="now"
          aria-label="now"
          role="heading"
        >
          Now - What I'm Tinkering With
        </h2>
      </div>
      <p class="text-muted-foreground text-sm mb-6 mt-1 whitespace-normal break-words" aria-label="now description">
        A running showcase of what I'm building, experimenting with, and actively maintaining.
      </p>

      <div class="relative flex flex-col gap-y-4 sm:gap-y-4.5 w-full min-w-0 pl-4 sm:pl-8 my-3">
        <!-- Continuous Timeline Line -->
        <div class="absolute left-[21px] sm:left-[37px] top-6 bottom-6 w-[2px] bg-border/40 z-0"></div>
        
        {
          projects.map((project) => (
            <div class="relative pl-10 sm:pl-16 z-10 group/timeline w-full min-w-0">
              <!-- Timeline Dot -->
              <div class="absolute left-0 top-[24px] -translate-y-1/2 w-3 h-3 rounded-full bg-border ring-4 ring-background transition-colors duration-300 group-hover/timeline:bg-primary z-10"></div>
              <ProjectTimelineCard project={project} />
            </div>
          ))
        }
      </div>

      <div class="flex justify-center mt-6" aria-label="view full projects">
        <Link
          href="/projects"
          class={buttonVariants({ variant: 'ghost' }) + ' group'}
        >
          View all projects <span
            class="ml-1.5 transition-transform group-hover:translate-x-1"
            >&rarr;</span
          >
        </Link>
      </div>
    </section>

    <section class="flex flex-col gap-y-4 animate-fade-in-up delay-400 w-full min-w-0" aria-labelledby="latest-posts-title" role="region">
      <div class="relative w-full min-w-0" aria-labelledby="latest-posts-title">
        <h2
          id="latest-posts-title"
          class="font-custom text-foreground text-xl sm:text-2xl font-bold break-words"
          title="latest blog posts"
          aria-label="latest blog posts"
        >
          Latest Blog Posts
        </h2>
        <p class="text-muted-foreground text-sm" aria-label="blog description">
          Here are some of my latest blog posts. You can find more on my blog
          page.
        </p>
      </div>
      <ul class="flex flex-col gap-y-4">
        {
          blog.map((post) => (
            <li>
              <BlogCard entry={post} />
            </li>
          ))
        }
      </ul>
      <div class="flex justify-center" aria-label="see all posts">
        <Link
          href="/blog"
          class={buttonVariants({ variant: 'ghost' }) + ' group'}
        >
          See all posts <span
            class="ml-1.5 transition-transform group-hover:translate-x-1"
            >&rarr;</span
          >
        </Link>
      </div>
    </section>
  </section>
</Layout>
