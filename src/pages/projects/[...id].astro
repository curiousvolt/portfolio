---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import { badgeVariants } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { render, getCollection, type CollectionEntry } from 'astro:content'
import PageHead from '@/components/PageHead.astro'
import { MobileTOC } from '@/components/react/MobileTOC'
import { ProjectPerspectiveTabs } from '@/components/react/ProjectPerspectiveTabs'
import { SITE } from '@/consts'

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map((project) => ({
    params: { id: project.id },
    props: project,
  }))
}

const project = Astro.props
const { Content, headings } = await render(project)

// Check for companion product.mdx
let ProductContent: any = null
let productHeadings: any[] = []
try {
  const allProjectsRaw = await getCollection('projects')
  const productEntry = allProjectsRaw.find((p: CollectionEntry<'projects'>) => p.id === `${project.id}/product`)
  if (productEntry) {
    const renderedProduct = await render(productEntry)
    ProductContent = renderedProduct.Content
    productHeadings = renderedProduct.headings || []
  }
} catch (e) {
  // fallback if no companion
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Projects',
  headline: project.data.name,
  datePublished: project.data.startDate || '',
  dateModified: project.data.endDate || project.data.startDate || '',
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  image: new URL(`/image/${project.id}.png`, Astro.site || SITE.href).toString(),
  keywords: project.data.tags ? project.data.tags.join(', ') : '',
  description: project.data.description || '',
}
const currentUrl = Astro.url;

const status = project.data.status || 'Building'
const statusConfig: Record<string, { dot: string; pulse: boolean; label: string; hint: string }> = {
  Shipped: {
    dot: 'bg-emerald-500',
    pulse: false,
    label: 'Shipped',
    hint: 'Live project available to use',
  },
  Building: {
    dot: 'bg-amber-400',
    pulse: true,
    label: 'Building',
    hint: 'Currently in active development',
  },
  Prototype: {
    dot: 'bg-sky-400',
    pulse: false,
    label: 'Prototype',
    hint: 'Early version / experiment',
  },
}
const currentStatus = statusConfig[status] || statusConfig.Building
---

<Layout canonicalUrl={currentUrl} isWide={true}> 
  <PageHead 
    slot="head" 
    title={project.data.name} 
    description={project.data.description} 
    image={project.data.image?.src || `/image/${project.id}.png`} 
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <section
    class="mx-auto w-full max-w-3xl xl:max-w-[1440px] 2xl:max-w-[1600px] flex flex-col gap-y-3 sm:gap-y-6"
  >
    <div class="flex flex-col gap-y-4 xl:grid xl:grid-cols-[280px_minmax(0,760px)_280px] 2xl:grid-cols-[320px_minmax(0,860px)_320px] xl:gap-x-8 2xl:gap-x-10 xl:gap-y-6 xl:justify-center animate-fade-in-up">
      <div class="hidden xl:block"></div>
      <div class="flex flex-col gap-y-4 sm:gap-y-6 text-start">
        <div>
          <Breadcrumbs
            items={[
              { href: '/projects', label: 'Projects', icon: 'lucide:folder' },
              { label: project.data.name, icon: 'lucide:folder-open' },
            ]}
          />
        </div>
        <div class="flex flex-col">
          <h1
            class="mb-2 text-3xl leading-tight font-medium text-pretty sm:text-5xl 2xl:text-[54px]"
          >
            {project.data.name}
          </h1>

          <div class="mt-4 mb-3 sm:my-6 rounded-xl overflow-hidden w-full aspect-video border border-border/50 bg-muted">
            <Image
              src={project.data.image}
              alt={project.data.name}
              class="w-full h-full object-cover"
              format="webp"
              fetchpriority="high"
              loading="eager"
              decoding="async"
              width={1200}
              height={800}
            />
          </div>

          <div class="flex flex-wrap items-center justify-start gap-2">
            <span
              title={currentStatus.hint}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium border border-border/60 bg-secondary/50 text-foreground/80 shadow-2xs"
            >
              <span
                class:list={[
                  'w-1.5 h-1.5 rounded-full',
                  currentStatus.dot,
                  currentStatus.pulse && 'animate-pulse',
                ]}
              />
              {currentStatus.label}
            </span>

            {
              project.data.tags && project.data.tags.length > 0 ? (
                project.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}`}
                    class={badgeVariants({ variant: 'secondary' })}
                  >
                    <Icon name="lucide:hash" class="size-3" />
                    {tag}
                  </a>
                ))
              ) : (
                <span class="text-muted-foreground text-sm">
                  No tags available
                </span>
              )
            }
          </div>
        </div>
      </div>
      <div class="hidden xl:block"></div>
    </div>

    <div class="flex flex-col gap-y-2 sm:gap-y-6 xl:grid xl:grid-cols-[280px_minmax(0,760px)_280px] 2xl:grid-cols-[320px_minmax(0,860px)_320px] xl:gap-x-8 2xl:gap-x-10 xl:gap-y-6 xl:justify-center">
      <div class="hidden xl:block xl:order-none">
        <div class="xl:sticky xl:top-24 max-h-[calc(100vh-7.5rem)] flex flex-col">
          {headings.length > 0 && (
            <div id="project-technical-toc" class="flex flex-col min-h-0 flex-1">
              <TableOfContents headings={headings} />
            </div>
          )}
          {productHeadings.length > 0 && (
            <div id="project-product-toc" class="hidden flex-col min-h-0 flex-1">
              <TableOfContents headings={productHeadings} />
            </div>
          )}
        </div>
      </div>

      <div class="order-2 xl:order-none flex flex-col gap-y-1 sm:gap-y-2.5 min-w-0 max-w-none">
        <ProjectPerspectiveTabs client:load />
        
        {ProductContent && (
          <div id="project-product-content" class="hidden">
            <article class="prose dark:prose-invert min-w-0 max-w-none [&>*:first-child]:mt-1 sm:[&>*:first-child]:mt-2" aria-label="Product Perspective">
              <ProductContent />
            </article>
          </div>
        )}

        <div id="project-technical-content">
          <article class="prose dark:prose-invert min-w-0 max-w-none [&>*:first-child]:mt-1 sm:[&>*:first-child]:mt-2" aria-label="Technical Perspective">
            <Content />
          </article>
        </div>

        <script is:inline>
          (function() {
            function syncPerspective() {
              var params = new URLSearchParams(window.location.search);
              var r = params.get('role');
              var role = (r ? r.toLowerCase() : null) || (typeof sessionStorage !== 'undefined' ? sessionStorage.getItem('cv_active_role') : null);
              var isPM = role === 'pm';
              var prod = document.getElementById('project-product-content');
              var tech = document.getElementById('project-technical-content');
              var prodTOC = document.getElementById('project-product-toc');
              var techTOC = document.getElementById('project-technical-toc');

              if (isPM && prod && tech) {
                prod.classList.remove('hidden');
                tech.classList.add('hidden');
                if (prodTOC) { prodTOC.classList.remove('hidden'); prodTOC.classList.add('flex'); }
                if (techTOC) { techTOC.classList.add('hidden'); techTOC.classList.remove('flex'); }
                document.documentElement.setAttribute('data-project-tab', 'product');
                window.dispatchEvent(new CustomEvent('cv_tab_switched', { detail: { tab: 'product' } }));
              }
            }

            syncPerspective();
            document.addEventListener('astro:page-load', syncPerspective);

            // Instant click fallback on perspective tabs
            document.addEventListener('click', function(e) {
              var btn = e.target.closest('[data-perspective]');
              if (!btn) return;
              var tab = btn.getAttribute('data-perspective');
              var prod = document.getElementById('project-product-content');
              var tech = document.getElementById('project-technical-content');
              var prodTOC = document.getElementById('project-product-toc');
              var techTOC = document.getElementById('project-technical-toc');

              if (tab === 'product' && prod && tech) {
                prod.classList.remove('hidden');
                tech.classList.add('hidden');
                if (prodTOC) { prodTOC.classList.remove('hidden'); prodTOC.classList.add('flex'); }
                if (techTOC) { techTOC.classList.add('hidden'); techTOC.classList.remove('flex'); }
                document.documentElement.setAttribute('data-project-tab', 'product');
                window.dispatchEvent(new CustomEvent('cv_tab_switched', { detail: { tab: 'product' } }));
              } else if (tab === 'technical' && prod && tech) {
                prod.classList.add('hidden');
                tech.classList.remove('hidden');
                if (prodTOC) { prodTOC.classList.add('hidden'); prodTOC.classList.remove('flex'); }
                if (techTOC) { techTOC.classList.remove('hidden'); techTOC.classList.add('flex'); }
                document.documentElement.setAttribute('data-project-tab', 'technical');
                window.dispatchEvent(new CustomEvent('cv_tab_switched', { detail: { tab: 'technical' } }));
              }
            });
          })();
        </script>
      </div>

      <div class="order-3 xl:order-none" id="project-details">
        <div class="xl:sticky xl:top-24 max-h-[calc(100vh-7.5rem)] flex flex-col">
          <aside class="flex flex-col">
            <div class="flex flex-col gap-4 rounded-xl border bg-card p-4 2xl:p-5 shadow-md transition-all duration-300">
          <div class="flex items-center justify-between">
            <h2 class="text-base 2xl:text-[17px] font-semibold whitespace-nowrap">Project Details</h2>
            <span
              title={currentStatus.hint}
              class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] 2xl:text-xs font-mono font-medium border border-border/60 bg-secondary/50 text-foreground/80 shadow-2xs"
            >
              <span
                class:list={[
                  'w-1.5 h-1.5 rounded-full',
                  currentStatus.dot,
                  currentStatus.pulse && 'animate-pulse',
                ]}
              />
              {currentStatus.label}
            </span>
          </div>
          <div class="flex flex-col gap-2 text-sm 2xl:text-[15px] leading-relaxed 2xl:leading-[1.7] text-muted-foreground">
            <p>{project.data.description}</p>
          </div>

          <hr class="my-4 border-t border-border" />

          <div class="flex flex-col gap-2 text-sm 2xl:text-[15px] text-muted-foreground">
            <h3 class="text-base 2xl:text-[17px] font-semibold text-foreground">Project Links</h3>
            <ul class="list-disc pl-4 text-sm 2xl:text-[15px]">
              <li>
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" aria-label="Project link" class="break-all hover:underline transition-colors hover:text-primary">
                  {project.data.link}
                </a>
              </li>
            </ul>
          </div>

          <hr class="my-4 border-t border-border" />

          <div class="flex flex-col gap-2 text-sm 2xl:text-[15px] text-muted-foreground">
            <h3 class="text-base 2xl:text-[17px] font-semibold text-foreground">Share this project</h3>
            <div class="flex flex-wrap gap-2">
              <Link
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.site + 'projects/' + project.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Share on Facebook"
                aria-label="Share on Facebook"
              >
                <Button variant="outline" size="icon" aria-label="Share on Facebook" className="group">
                  <Icon name="line-md:facebook" class="size-4 draw-icon group-hover:text-primary transition-colors duration-300" />
                </Button>
              </Link>
              <Link
                href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.site + 'projects/' + project.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Share on Twitter"
                aria-label="Share on Twitter"
              >
                <Button variant="outline" size="icon" aria-label="Share on Twitter" className="group">
                  <Icon name="line-md:twitter-x" class="size-4 draw-icon group-hover:text-primary transition-colors duration-300" />
                </Button>
              </Link>
              <Link
                href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.site + 'projects/' + project.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Share on LinkedIn"
                aria-label="Share on LinkedIn"
              >
                <Button variant="outline" size="icon" aria-label="Share on LinkedIn" className="group">
                  <Icon name="line-md:linkedin" class="size-4 draw-icon group-hover:text-primary transition-colors duration-300" />
                </Button>
              </Link>
              <Link
                href={`https://www.reddit.com/submit?url=${encodeURIComponent(Astro.site + 'projects/' + project.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Share on Reddit"
                aria-label="Share on Reddit"
              >
                <Button variant="outline" size="icon" aria-label="Share on Reddit" className="group">
                  <Icon name="line-md:reddit-loop" class="size-4 draw-icon group-hover:text-primary transition-colors duration-300" />
                </Button>
              </Link>
              <Link
                href={`https://wa.me/?text=${encodeURIComponent(Astro.site + 'projects/' + project.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Share on WhatsApp"
                aria-label="Share on WhatsApp"
              >
                <Button variant="outline" size="icon" aria-label="Share on WhatsApp" className="group">
                  <Icon name="mdi:whatsapp" class="size-4 draw-icon group-hover:text-primary transition-colors duration-300" />
                </Button>
              </Link>
              <Link
                href={`https://t.me/share/url?url=${encodeURIComponent(Astro.site + 'projects/' + project.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                title="Share on Telegram"
                aria-label="Share on Telegram"
              >
                <Button variant="outline" size="icon" aria-label="Share on Telegram" className="group">
                  <Icon name="line-md:telegram" class="size-4 draw-icon group-hover:text-primary transition-colors duration-300" />
                </Button>
              </Link>
            </div>
          </div>
        </div>
      </aside>
        </div>
      </div>
    </div>

  </section>

  {(headings.length > 0 || productHeadings.length > 0) && (
    <MobileTOC 
      client:load 
      headings={headings} 
      productHeadings={productHeadings} 
      title={project.data.name} 
    />
  )}

  <Button
    variant="outline"
    size="icon"
    className="group fixed right-8 bottom-8 z-50 hidden"
    id="scroll-to-top"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <Icon
      name="lucide:arrow-up"
      class="mx-auto size-4 transition-all group-hover:-translate-y-0.5"
    />
  </Button>

  <script>
    document.addEventListener('astro:page-load', () => {
      const scrollToTopButton = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')

      if (scrollToTopButton && footer) {
        scrollToTopButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })

        window.addEventListener('scroll', () => {
          const footerRect = footer.getBoundingClientRect()
          const isFooterVisible = footerRect.top <= window.innerHeight

          scrollToTopButton.classList.toggle(
            'hidden',
            window.scrollY <= 300 || isFooterVisible
          )
        })
      }
    })
  </script>
</Layout>
