---
import Layout from '@/layouts/Layout.astro'
import PageHead from '@/components/PageHead.astro'
import { AboutContent } from '@/components/react/about-layout'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { SITE } from '@/consts'
import { getCollection } from 'astro:content'

const sideProjects = await getCollection('sideProjects')
const media = await getCollection('media')

const currentUrl = Astro.url;

import { GITHUB_REPOS } from '@/consts'
let graphSvg = null;
let githubData = { repos: GITHUB_REPOS, stars: '3.2k+', forks: '600+' };

try {
  const response = await fetch('https://ghchart.rshah.org/CuriousVolt');
  if (response.ok) {
    let svg = await response.text();
    // Strip text elements
    svg = svg.replace(/<text[^>]*>.*?<\/text>/g, '');
    // Crop viewbox to just the grid
    svg = svg.replace(/width="[^"]*" height="[^"]*"/, 'viewBox="27 20 634 82" width="100%" height="100%"');
    // Remove the hardcoded fill colors and make the squares rounded
    svg = svg.replace(/style="fill:#[a-fA-F0-9]+;shape-rendering:crispedges;"/g, 'rx="2" ry="2"');
    graphSvg = svg;
  }
} catch (e) {
  console.error("Failed to fetch Github Chart", e);
}

try {
  const response = await fetch('https://api.github.com/users/CuriousVolt/repos?per_page=100')
  if (response.ok) {
    const data = await response.json()
    let stars = 0
    let forks = 0
    const formattedRepos = data
      .filter((repo: any) => !repo.fork)
      .map((repo: any) => {
        stars += repo.stargazers_count
        forks += repo.forks_count
        return {
          name: repo.name,
          description: repo.description || 'No description provided.',
          language: repo.language || 'Documentation',
          stars: repo.stargazers_count.toString(),
          forks: repo.forks_count.toString(),
          url: repo.html_url,
          pushed_at: repo.pushed_at
        }
      })
    
    formattedRepos.sort((a: any, b: any) => {
      const starDiff = parseInt(b.stars) - parseInt(a.stars)
      if (starDiff !== 0) return starDiff
      return new Date(b.pushed_at || 0).getTime() - new Date(a.pushed_at || 0).getTime()
    })
    
    githubData = { repos: formattedRepos.slice(0, 4), stars: stars.toString(), forks: forks.toString() };
  }
} catch (e) {
  console.error("Failed to fetch Github Repos", e);
}
---

<Layout canonicalUrl={currentUrl}>
  <PageHead slot="head" title="About" />
  <section class="min-h-screen">
     <div class="mb-6 sm:mb-8">
       <Breadcrumbs items={[{ label: 'About', icon: 'lucide:user' }]} />
     </div>
     <AboutContent client:load initialGraphSvg={graphSvg} githubData={githubData} sideProjects={sideProjects} media={media} />
  </section>
</Layout>
