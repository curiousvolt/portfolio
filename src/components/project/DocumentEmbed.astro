---
import { Icon } from 'astro-icon/components'

interface Props {
  src: string
  title?: string
  height?: string
  type?: 'pdf' | 'document' | 'figma'
  className?: string
}

const {
  src,
  title = 'Document Preview',
  height = '560px',
  type = 'pdf',
  className = '',
} = Astro.props

const isPdf = src.endsWith('.pdf') || type === 'pdf'
const isFigma = src.includes('figma.com') || type === 'figma'

const iconName = isFigma ? 'lucide:figma' : isPdf ? 'lucide:file-text' : 'lucide:file'
---

<div class={`my-6 rounded-2xl overflow-hidden border border-border/70 bg-card/60 shadow-md max-w-full ${className}`}>
  <div class="flex items-center justify-between gap-2 px-4 py-3 bg-secondary/50 border-b border-border/60 text-xs">
    <div class="flex items-center gap-2.5 text-foreground/90 font-medium truncate min-w-0">
      <span class="p-1 rounded-md bg-primary/10 text-primary">
        <Icon name={iconName} class="size-4" />
      </span>
      <span class="truncate font-semibold text-xs sm:text-sm">{title}</span>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      {isPdf && (
        <a
          href={src}
          download
          class="hidden sm:inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground font-medium"
        >
          <Icon name="lucide:download" class="size-3.5" />
          <span>Download</span>
        </a>
      )}
      <a 
        href={src} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs text-primary hover:underline font-semibold"
      >
        <span>Open Fullscreen</span>
        <Icon name="lucide:external-link" class="size-3" />
      </a>
    </div>
  </div>
  <iframe
    src={src}
    title={title}
    class="w-full border-none bg-background/50"
    style={`height: ${height};`}
    loading="lazy"
  ></iframe>
</div>
