---
import { SITE } from '@/consts'
import Favicons from './Favicons.astro'
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow" />
  <meta name="google" content="notranslate" />
  <meta name="revisit-after" content="1 days" />

  <!-- SEO Enhancement Tags -->
  <meta name="author" content={SITE.author} />
  <meta name="publisher" content={SITE.title} />
  <meta name="language" content={SITE.locale} />
  <meta name="geo.region" content="IN" />
  <meta name="geo.placename" content={SITE.location} />
  {(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || import.meta.env.GOOGLE_SITE_VERIFICATION) && (
    <meta
      name="google-site-verification"
      content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || import.meta.env.GOOGLE_SITE_VERIFICATION}
    />
  )}

  <!-- Mobile and PWA Tags -->
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content={SITE.title} />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <!-- Theme Colors -->
  <meta
    name="theme-color"
    content="#121212"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#ffffff"
    media="(prefers-color-scheme: light)"
  />
  <meta name="msapplication-TileColor" content="#121212" />

  <!-- Feed link -->
  <link rel="manifest" href="/site.webmanifest" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${SITE.title} RSS Feed`}
    href={new URL('rss.xml', Astro.site)}
  />

  <!-- KaTeX CSS for LaTeX Mathematics -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    crossorigin="anonymous"
  />

  <Favicons />

  <script is:inline>
    // Client-side role persistence: checks ?role=pm or ?role=pe in sessionStorage
    (function () {
      try {
        if (localStorage.getItem('cv_active_role')) {
          localStorage.removeItem('cv_active_role');
        }
        var params = new URLSearchParams(window.location.search);
        var r = params.get('role');
        if (r) {
          r = r.toLowerCase();
          if (r === 'pm') {
            sessionStorage.setItem('cv_active_role', 'pm');
          } else if (r === 'pe') {
            sessionStorage.removeItem('cv_active_role');
          }
        }

        var isPM = (r === 'pm') || (sessionStorage.getItem('cv_active_role') === 'pm');
        if (isPM) {
          var updateResumeLinks = function() {
            var links = document.querySelectorAll('a[data-resume-link], a[href*="/resume"]');
            links.forEach(function(el) {
              var href = el.getAttribute('href');
              if (href && !href.includes('resume-pm') && !href.startsWith('#')) {
                el.setAttribute('href', href.replace('/resume', '/resume-pm'));
              }
            });
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', updateResumeLinks);
          } else {
            updateResumeLinks();
          }
        }
      } catch (e) {}
    })();
  </script>

  <slot />
</head>
